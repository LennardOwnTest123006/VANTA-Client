{
  "$schema": "./tokens.schema.json",
  "name": "VANTA Design Tokens",
  "version": "1.0.0",
  "color": {
    "bg": { "void": "#07070A", "base": "#0B0B10" },
    "surface": { "1": "#111118", "2": "#17171F", "3": "#1F1F29", "4": "#272733" },
    "border": { "subtle": "#232330", "strong": "#2C2C3A", "focus": "#9B82FF" },
    "text": { "primary": "#F5F5F7", "secondary": "#A1A1AA", "muted": "#6B6B78", "inverse": "#0B0B10" },
    "accent": {
      "violet": "#7C5CFF",
      "violetHover": "#9B82FF",
      "violetPressed": "#5B3DE0",
      "violetSoft": "#7C5CFF33",
      "blue": "#4F8DFF",
      "blueSoft": "#4F8DFF33"
    },
    "state": { "success": "#3DDC97", "warning": "#F5B942", "danger": "#FF5C7A", "info": "#4F8DFF" },
    "gradient": {
      "accent": { "angle": 135, "stops": ["#7C5CFF", "#4F8DFF"] },
      "hero": { "angle": 180, "stops": ["#0B0B10", "#07070A"] }
    }
  },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "pill": 999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },
  "typography": {
    "family": {
      "ui": "Inter",
      "display": "Space Grotesk",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36, "4xl": 48, "5xl": 64 },
    "tracking": { "display": "-0.02em", "wordmark": "0.18em", "label": "0.08em" },
    "leading": { "tight": 1.1, "snug": 1.3, "normal": 1.55 }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.5)",
    "md": "0 8px 24px rgba(0,0,0,0.45)",
    "lg": "0 24px 64px rgba(0,0,0,0.55)",
    "glow": "0 0 0 1px rgba(124,92,255,0.35), 0 8px 32px rgba(124,92,255,0.25)"
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": { "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)", "emphasized": "cubic-bezier(0.3, 0, 0, 1)" }
  },
  "ingame": {
    "comment": "Values used by the Minecraft client UI kit (GUI-scaled pixels).",
    "radius": { "sm": 2, "md": 3, "lg": 4 },
    "spacing": { "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 24 },
    "panelAlpha": 0.82,
    "blur": true
  }
}
