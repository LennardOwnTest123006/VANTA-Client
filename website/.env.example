# VANTA website environment variables (all optional).
# Copy to `.env.local` for local development. Netlify: Site settings → Environment variables.
#
# Download URLs. When a URL is set it overrides the `downloadUrl` from the release manifest
# in shared/releases/. When neither is set the download page shows "Not published yet".
VITE_DOWNLOAD_LAUNCHER_URL=
VITE_DOWNLOAD_CLIENT_URL=

# Base URL of the published release manifests (used for the "all releases" link and by the launcher updater),
# e.g. https://vanta.example/releases — no trailing slash.
VITE_RELEASES_BASE_URL=

# Support contact shown in the footer and on the support page. Leave empty to hide.
VITE_SUPPORT_EMAIL=

# Community links. Only links that are configured are rendered.
VITE_DISCORD_URL=
VITE_GITHUB_URL=https://github.com/LennardOwnTest123006/VANTA-Client
